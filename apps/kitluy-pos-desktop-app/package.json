{
  "name": "@kitluy-apps/kitluy-pos-desktop-app",
  "version": "0.1.0",
  "private": true,
  "description": "POS Desktop App \u2014 Electron/Linux ARM64 operational client implementing the owner-locked T1-T4 profiles through the Store Hub (POS spec v4.0.0).",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "build:release-payload": "node scripts/build-release-payload.mjs",
    "clean": "rm -rf dist dist-electron release-payload"
  },
  "dependencies": {
    "@kitluy-verticals/phase1-laundry": "workspace:*",
    "@kitluy/device-identity": "workspace:*",
    "@kitluy/digital-store-context": "workspace:*",
    "@kitluy/edge-contracts": "workspace:*",
    "@kitluy/feature-flags": "workspace:*",
    "@kitluy/localization": "workspace:*",
    "@kitluy/shared-types": "workspace:*",
    "@kitluy/terminal-local-store": "workspace:*",
    "@kitluy/terminal-seat-contracts": "workspace:*",
    "@kitluy/web-ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@kitluy-services/kitluy-hub-agent": "workspace:*",
    "@types/node": "catalog:",
    "@types/node-forge": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "catalog:",
    "electron": "38.8.6",
    "node-forge": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@kitluy-services/kitluy-device-registry-service": "workspace:*",
    "@kitluy-services/kitluy-device-firstboot-agent": "workspace:*"
  }
}
