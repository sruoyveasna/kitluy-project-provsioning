#!/bin/sh
# KitLuy Store Hub — encrypted NVMe data volume, provisioned at first boot.
#
# =============================================================================
# WHAT THIS OWNS
# =============================================================================
# The Hub's local database lives on an NVMe drive, encrypted with LUKS2, unlocked
# automatically at boot by a key bound to THIS Raspberry Pi. Nothing else on the
# device may write there, and the volume is useless in another machine.
#
# Owner decision: NVMe is REQUIRED. A Hub without one does not silently fall back
# to the SD card — an SD card is not durable enough to hold a shop's till, and a
# Hub that quietly degraded to one would lose a day's takings on a card failure
# nobody was warned about. It refuses, and says so.
#
# =============================================================================
# WHERE THE ENCRYPTION KEY COMES FROM, AND WHY NOT THE OBVIOUS PLACE
# =============================================================================
# From the Pi's OTP device-unique private key, read with `rpi-otp-private-key`.
# That value lives in one-time-programmable fuses, is NOT exposed by
# `vcgencmd otp_dump`, and cannot be recovered from the NVMe itself. So a drive
# removed from a Hub and put in a reader is ciphertext.
#
# It is NOT used as the passphrase directly. The passphrase is an HMAC of a fixed
# domain string under that key, so the OTP secret is never written anywhere, and
# a future second use of the same OTP key for another purpose cannot collide with
# this one.
#
# The upstream rpi-image-gen pattern (`block-device-id | rpi-fw-crypto hmac`) is
# NOT used, because neither tool exists on this image: they ship with Raspberry Pi
# OS and this is Debian Bookworm minbase. That was verified against the built
# rootfs rather than assumed, and it is why this derives its own key instead.
#
# IF THE OTP KEY IS NOT PROGRAMMED, THIS REFUSES.
# Writing it burns fuses and can never be undone — OTP bits do not return from 1
# to 0. That is an owner decision about a physical board, not something a boot
# script may do on its own initiative, and silently falling back to a weaker key
# would give encryption that only LOOKS like it is bound to hardware.
#
# =============================================================================
# THE ONE EXCEPTION: DEVELOPMENT-UNBOUND STORAGE
# =============================================================================
# Named for what is true about it: the key is NOT BOUND to the board. A drive
# carrying it is readable in any machine that also has the key file, which is
# exactly the property OTP binding exists to prevent. It is not a weaker version
# of production security; it is a different thing, and the name says so on every
# line that mentions it.
#
# It exists because irreversible fuse programming must not sit on the software
# development critical path. Reaching it requires ALL FOUR of:
#
#   1. no OTP key is programmed        -- OTP ALWAYS wins when it is available
#   2. KITLUY_ENVIRONMENT=development  -- and `unknown` when unreadable, so a
#                                         missing image.env fails closed
#   3. an operator-created marker file -- never shipped in the image, so no
#                                         golden image can boot into this path
#   4. /var/lib/kitluy not group- or world-writable
#
# THE KEY IS DERIVED, NOT STORED (changed 2026-09-08).
#
# It used to be 32 random bytes written to `/var/lib/kitluy/development-unbound-
# storage.key`. That directory is on the SD card's persistent partition, and the
# volume it unlocks is on the NVMe -- so RE-FLASHING THE SD CARD destroyed the
# only copy of the key while leaving the encrypted drive intact. The volume was
# then unopenable for ever, and since re-flashing is routine in development this
# happened on every flash. Observed on a real Hub, 2026-09-08.
#
# So the key is now HMAC-SHA256 of a fixed domain string under the BOARD SERIAL,
# which lives in the SoC and survives any amount of re-flashing. Nothing is
# written to disk, so there is no copy to lose and none to steal.
#
# THE BOARD SERIAL IS NOT SECRET. It is printed by `/proc/cpuinfo` to any local
# user and is reported to the fleet as hardware evidence. Anyone who can read it
# can derive this key. That is precisely why this posture stays refused outside
# `KITLUY_ENVIRONMENT=development` and still demands an operator's marker file:
# it buys REPRODUCIBILITY, not secrecy, and it is not a step toward production.
# What it does add over the old random key is that the volume is now bound to
# this board rather than to a file anyone holding the SD card could read.
#
# The resulting posture is recorded in a world-readable label file so an operator
# and the Hub agent can both see which path was taken WITHOUT reading key
# material. `bin/hub-agent.ts` refuses to serve when that label says
# DEVELOPMENT-UNBOUND and the environment is not development.
set -eu

# Resolve the data drive by TYPE, never by a hardcoded /dev/nvme0n1: a Hub with
# two drives, or one that enumerates differently after a firmware update, must
# not silently encrypt the wrong disk. Sets NVME_DEVICE; returns non-zero when
# there is none, so each caller phrases its own refusal.
#
# A FUNCTION because two paths need it now -- boot provisioning and
# --reset-data-volume -- and a second copy of "which disk is the Store's" is
# exactly the kind of duplication that ends with one of them wrong.
NVME_DEVICE=""
find_nvme() {
  NVME_DEVICE=""
  for candidate in /dev/nvme*n1; do
    [ -b "$candidate" ] || continue
    if [ -n "$NVME_DEVICE" ]; then
      die "more than one NVMe drive is present ($NVME_DEVICE, $candidate); this Hub will not guess which one holds the Store's data"
    fi
    NVME_DEVICE="$candidate"
  done
  [ -n "$NVME_DEVICE" ]
}

usage() {
  cat >&2 <<'USAGE'
Usage: hub-storage-provision [options]

  (no options)                      Provision and unlock the data volume. This is
                                    what the systemd unit runs at boot.

  --explain                         Print the storage posture and exit. Touches
                                    no device and writes no state.
  --key-fingerprint                 Print a NON-SECRET fingerprint of the volume
                                    key, to prove two derivations agree.

RECOVERY (deliberate, never automatic):
  --authorize-development-unbound   Allow this board to use a key derived from
                                    its serial instead of OTP fuses. Development
                                    only; refused in every other environment.
  --reset-data-volume               DESTROY the data volume and re-provision it.
                                    Use when the drive carries a LUKS container
                                    this board can no longer open -- for example
                                    after the key was lost. Everything on the
                                    drive is unrecoverable afterwards.
USAGE
}

log()  { printf '[kitluy-hub-storage] %s\n' "$*"; }
die()  { printf '[kitluy-hub-storage] REFUSED: %s\n' "$*" >&2; exit 1; }

MAPPER_NAME="kitluy-hub-data"
MOUNT_POINT="/var/lib/kitluy/hub"
STATE_DIR="/var/lib/kitluy/hub"
PROVISIONED_MARKER="/var/lib/kitluy/hub/.luks-provisioned"

# The persistent-slot directory. NOT the encrypted volume — everything below
# must be readable BEFORE that volume is unlocked.
#
# `--state-root` and `--etc-root` exist ONLY so the decision below can be tested
# off-device, the same reason `image-env.ts` takes an `etcRoot` parameter. They
# grant nothing: whoever can pass them can already run this script as root.
STATE_ROOT="/var/lib/kitluy"
ETC_ROOT="/etc"
EXPLAIN_ONLY="no"
FINGERPRINT_ONLY="no"
RESET_VOLUME="no"
AUTHORIZE_UNBOUND="no"
# The SoC serial, which no re-flash can change. `/proc/cpuinfo` is the fallback.
BOARD_SERIAL_FILE="/sys/firmware/devicetree/base/serial-number"

while [ $# -gt 0 ]; do
  case "$1" in
    --explain)    EXPLAIN_ONLY="yes"; shift ;;
    # Prints a NON-SECRET fingerprint of the derived passphrase, never the
    # passphrase. It exists so the regression this file was written for -- the
    # key must not change when the state directory is wiped -- is testable at
    # all: the passphrase itself must never reach a terminal or a test log.
    --key-fingerprint) FINGERPRINT_ONLY="yes"; shift ;;
    # ------------------------------------------------------------------------
    # RECOVERY. Two commands, each doing ONE thing, both discoverable in --help.
    # ------------------------------------------------------------------------
    # Written because the recovery for a lost storage key was "know to run
    # wipefs on the right device, and know the marker's path" -- which only
    # works if the person who wrote it is in the room. Neither is automatic and
    # neither runs at boot: the refusal that sends you here exists because this
    # script cannot tell a spare drive from one holding another Store's records.
    --reset-data-volume)          RESET_VOLUME="yes"; shift ;;
    --authorize-development-unbound) AUTHORIZE_UNBOUND="yes"; shift ;;
    -h|--help)                    usage; exit 0 ;;
    --state-root) STATE_ROOT="${2:?--state-root needs a directory}"; shift 2 ;;
    --etc-root)   ETC_ROOT="${2:?--etc-root needs a directory}"; shift 2 ;;
    --serial-file) BOARD_SERIAL_FILE="${2:?--serial-file needs a path}"; shift 2 ;;
    *) die "unknown argument '$1'" ;;
  esac
done

DEV_UNBOUND_MARKER="${STATE_ROOT}/DEVELOPMENT-UNBOUND-STORAGE-AUTHORIZED"
DEV_UNBOUND_KEY="${STATE_ROOT}/development-unbound-storage.key"
POSTURE_FILE="${STATE_ROOT}/storage-posture"

# Same two lines `hub-database-provision` uses, and for the same reason: the
# `unknown` default is what makes an unreadable image.env fail closed.
[ -f "${ETC_ROOT}/kitluy/image.env" ] && . "${ETC_ROOT}/kitluy/image.env"
ENVIRONMENT="${KITLUY_ENVIRONMENT:-unknown}"
# hub.env carries KITLUY_HUB_STORAGE_DEVELOPMENT_UNBOUND, which a DEVELOPMENT
# image may set to `authorized` (owner ruling 2026-09-23). Read AFTER image.env
# so it can never redefine the environment that gates it: the value below is
# pinned from image.env before this file is sourced.
[ -f "${ETC_ROOT}/kitluy/hub.env" ] && . "${ETC_ROOT}/kitluy/hub.env"
KITLUY_ENVIRONMENT="$ENVIRONMENT"

# -----------------------------------------------------------------------------
# 0. May this board provision at all, and with which key?
# -----------------------------------------------------------------------------
# Resolved BEFORE any device is touched, so the answer to "am I authorized" never
# depends on what hardware happens to be fitted, and so it can be asked with
# `--explain` without formatting anything.
resolve_storage_posture() {
  # OTP FIRST, ALWAYS. The development path is reachable only when this one is
  # genuinely unavailable, so a board whose fuses are programmed can never be
  # talked into the weaker posture by an environment variable or a stray file.
  if command -v rpi-otp-private-key >/dev/null 2>&1 \
     && rpi-otp-private-key -c >/dev/null 2>&1; then
    # `-c` exits non-zero when the key is all zeros, i.e. never programmed.
    STORAGE_POSTURE="OTP-BOUND"
    return 0
  fi

  # Condition 2: development only. Anything else — including `unknown` from an
  # unreadable image.env — refuses.
  if [ "$ENVIRONMENT" != "development" ]; then
    die "this board has no device-unique OTP key programmed.
  The Store Hub data volume is encrypted with a key bound to the board, and
  programming OTP is IRREVERSIBLE (fuses never return from 1 to 0), so it is an
  owner decision and not something first boot performs on its own.
  Provision the board, then reboot. See rpi-otp-private-key -h for the procedure.
  (environment is '${ENVIRONMENT}'; DEVELOPMENT-UNBOUND storage is refused outside development)"
  fi

  # Condition 3: this board is authorized for the unbound key — either by an
  # operator's marker file, or by a DEVELOPMENT image built to say so.
  #
  # WHY THE IMAGE MAY NOW SAY IT (owner ruling 2026-09-23). The marker lives on
  # the persistent partition, which a reflash rewrites, so every fresh Hub card
  # stopped dead here: storage refused, and with it the database, the agent and
  # the operational TLS — the whole Hub, with terminals reporting NO_HUB_FOUND
  # and nothing on the LAN to pair with. The owner met that wall on 2026-09-23
  # and ruled the gate out of the development path: "this is the reason I don't
  # want to encrypt my nvme anymore".
  #
  # What protects production is CONDITION 2 above, not this one: a production
  # image is built with KITLUY_ENVIRONMENT=production and dies before reaching
  # this line, whatever any file or variable says. The marker's own stated job
  # was that "no golden image can boot into this path" — which remains true of
  # every image that is not a development image, and a development image is
  # exactly the one that should not ask.
  #
  # It is still not silent: the posture label records DEVELOPMENT-UNBOUND either
  # way, the Hub agent reads that label, and the reason is logged at provision
  # time so an operator reading the journal sees which door was opened and why.
  if [ "${KITLUY_HUB_STORAGE_DEVELOPMENT_UNBOUND:-}" = "authorized" ] \
     && [ ! -e "$DEV_UNBOUND_MARKER" ]; then
    # NOT in --explain: that mode prints the label and nothing else, and the
    # suite asserts it (§8, "--explain leaks nothing but the label"). The
    # operator sees this line when the volume is actually provisioned.
    [ "$EXPLAIN_ONLY" = "yes" ] || \
      log "DEVELOPMENT-UNBOUND storage authorized by this development image (KITLUY_HUB_STORAGE_DEVELOPMENT_UNBOUND=authorized); the key is derived from the board serial and is NOT secret"
  elif [ ! -e "$DEV_UNBOUND_MARKER" ]; then
    die "this board has no device-unique OTP key programmed, and DEVELOPMENT-UNBOUND storage is not authorized.
  The Store Hub data volume is normally encrypted with a key bound to the board.
  Programming OTP is IRREVERSIBLE and is an owner decision.
  For DEVELOPMENT ONLY, and understanding that the resulting key is derived from
  the board serial -- which is NOT secret, so the volume is reproducible by
  anyone who can read it -- authorize the unbound key by creating:
      ${DEV_UNBOUND_MARKER}
  then reboot."
  fi

  # Condition 4: the directory holding the key must not be group- or
  # world-writable, or anyone with an account could replace the key file.
  # Mirrors `assertDevPkiDirectoryMode` (dev-operational-pki.ts) in shell.
  if [ -n "$(find "$STATE_ROOT" -maxdepth 0 -perm /022 2>/dev/null)" ]; then
    die "${STATE_ROOT} is group- or world-writable; refusing to keep an unbound storage key there"
  fi

  STORAGE_POSTURE="DEVELOPMENT-UNBOUND"
}

# Nothing is generated any more. A key file is honoured only where one already
# EXISTS, so a Hub provisioned before 2026-09-08 keeps opening the volume its
# random key encrypted; wiping that file here would orphan exactly the volumes
# this change exists to stop orphaning.
ensure_dev_unbound_key() {
  [ -s "$DEV_UNBOUND_KEY" ] || return 0
  # stderr: `--key-fingerprint` must put NOTHING but the fingerprint on stdout.
  log "using the legacy DEVELOPMENT-UNBOUND key file this board was provisioned with" >&2
  chmod 0600 "$DEV_UNBOUND_KEY"
}

# The board serial, from the SoC. Not secret -- see the header.
board_serial() {
  if [ -r "$BOARD_SERIAL_FILE" ]; then
    # Device-tree strings are NUL-terminated.
    tr -d '\000' < "$BOARD_SERIAL_FILE" | tr -d ' \t\n'
  else
    grep -m1 -i '^Serial' /proc/cpuinfo 2>/dev/null | awk '{ print $3 }' | tr -d ' \t\n'
  fi
}

# Writes the passphrase to stdout and NOTHING else. Both branches keep the secret
# out of the process table, the journal and every log line: the value is piped
# straight into cryptsetup and never assigned to a variable that outlives the call.
derive_passphrase() {
  case "$STORAGE_POSTURE" in
    OTP-BOUND)
      # HMAC of a fixed domain string under the OTP key. The OTP secret itself is
      # never written to disk, never logged, and never becomes the passphrase.
      otp_key="$(rpi-otp-private-key 2>/dev/null | tr -d ' \n')"
      [ -n "$otp_key" ] || die "the OTP device key read back empty"
      printf 'kitluy.hub-data-volume.v1' \
        | openssl dgst -sha256 -mac HMAC -macopt "hexkey:${otp_key}" -hex \
        | sed 's/^.*= //'
      unset otp_key
      ;;
    DEVELOPMENT-UNBOUND)
      if [ -s "$DEV_UNBOUND_KEY" ]; then
        # Legacy board: the volume is encrypted with the random key that used to
        # be generated here, and only that key can still open it.
        cat "$DEV_UNBOUND_KEY"
      else
        # Hex-encoded because `-macopt hexkey:` demands hex and a serial is not
        # required to be hex on every board; the Pi's happens to be.
        serial="$(board_serial)"
        [ -n "$serial" ] || die "the board serial read back empty; refusing to derive a storage key from nothing"
        serial_hex="$(printf '%s' "$serial" | od -An -tx1 | tr -d ' \n')"
        printf 'kitluy.hub-data-volume.development-unbound.v1' \
          | openssl dgst -sha256 -mac HMAC -macopt "hexkey:${serial_hex}" -hex \
          | sed 's/^.*= //'
        unset serial serial_hex
      fi
      ;;
    *)
      die "no storage key posture was resolved"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# --authorize-development-unbound
# ---------------------------------------------------------------------------
# BEFORE `resolve_storage_posture`, and it has to be: resolving is exactly what
# fails without this marker, so a command placed after it could never run on the
# board that needs it. (It was, once.)
#
# Writes the marker the boot path refuses without. It is a SEPARATE command from
# the wipe on purpose: authorising a weaker key posture and destroying a disk are
# two different decisions, and bundling them would let someone reach for one and
# get both.
if [ "$AUTHORIZE_UNBOUND" = "yes" ]; then
  if [ "$ENVIRONMENT" != "development" ]; then
    die "environment is '${ENVIRONMENT}'; DEVELOPMENT-UNBOUND storage is refused outside development"
  fi
  if command -v rpi-otp-private-key >/dev/null 2>&1 && rpi-otp-private-key -c >/dev/null 2>&1; then
    # OTP FIRST, ALWAYS -- the same rule resolve_storage_posture applies. A board
    # with fuses programmed must not be talked down to the weaker posture.
    die "this board has an OTP key programmed and will use it; the development posture is not available"
  fi
  install -d -m 0750 "$STATE_ROOT"
  : > "$DEV_UNBOUND_MARKER"
  chmod 0644 "$DEV_UNBOUND_MARKER"
  log "DEVELOPMENT-UNBOUND storage authorized on this board."
  log "  The volume key derives from the board serial, which is NOT secret."
  log "  Reboot, or run this command with no options, to provision the volume."
  exit 0
fi

STORAGE_POSTURE=""
resolve_storage_posture

if [ "$EXPLAIN_ONLY" = "yes" ]; then
  # Decision only. No key generated, no posture file written, no device touched.
  printf '%s\n' "$STORAGE_POSTURE"
  exit 0
fi

# ---------------------------------------------------------------------------
# --reset-data-volume
# ---------------------------------------------------------------------------
# The recovery for a drive this board can no longer open. It reports what it
# found BEFORE destroying it, so the operator can still stop -- and it refuses
# outright on the disk the Hub booted from.
if [ "$RESET_VOLUME" = "yes" ]; then
  find_nvme || die "no NVMe device found; there is nothing to reset"
  ROOT_SOURCE="$(findmnt -no SOURCE / 2>/dev/null || echo '')"
  case "$ROOT_SOURCE" in
    "$NVME_DEVICE"*) die "$NVME_DEVICE carries the running root filesystem; refusing to destroy the disk this Hub booted from" ;;
  esac

  log "device:  $NVME_DEVICE"
  log "size:    $(lsblk -no SIZE "$NVME_DEVICE" 2>/dev/null | head -1 | tr -d ' ')"
  if cryptsetup isLuks "$NVME_DEVICE" 2>/dev/null; then
    log "content: a LUKS container"
    if derive_passphrase 2>/dev/null | cryptsetup open --test-passphrase --key-file=- "$NVME_DEVICE" 2>/dev/null; then
      # Refusing here is the point: if the volume OPENS, its data is reachable
      # and destroying it would be a mistake, not a recovery.
      die "this board CAN open that volume; it is not orphaned. Refusing to destroy readable data."
    fi
    log "content: this board CANNOT open it -- the key it was created with is gone"
  else
    log "content: not a LUKS container"
  fi

  log "DESTROYING every byte on $NVME_DEVICE"
  wipefs -a "$NVME_DEVICE" >/dev/null
  log "done. Reboot, or run this command with no options, to provision a fresh volume."
  exit 0
fi

if [ "$FINGERPRINT_ONLY" = "yes" ]; then
  # A HASH of the passphrase, truncated. Enough to prove two derivations agree,
  # useless for opening anything. Writes no posture file and touches no device.
  ensure_dev_unbound_key
  derive_passphrase | openssl dgst -sha256 -hex | sed 's/^.*= //' | cut -c1-32
  exit 0
fi

# The key belongs to the authorization decision above, not to the disk, so it is
# committed here rather than after the device checks — a board that is authorized
# but has no drive fitted still has a stable key when one is.
if [ "$STORAGE_POSTURE" = "DEVELOPMENT-UNBOUND" ]; then
  ensure_dev_unbound_key
  log "STORAGE POSTURE: DEVELOPMENT-UNBOUND — the key derives from the board serial, which is NOT secret; this is NOT production security"
else
  log "storage posture: OTP-BOUND"
fi

# A label, never key material. World-readable on purpose: the Hub agent and an
# operator both need to know which path was taken, and neither should have to
# read a key to find out.
printf '%s\n' "$STORAGE_POSTURE" > "$POSTURE_FILE"
chmod 0644 "$POSTURE_FILE"

# -----------------------------------------------------------------------------
# 1. Already unlocked?
# -----------------------------------------------------------------------------
# Idempotent by construction: this runs on EVERY boot, not only the first. A
# provisioner that only worked once would leave a Hub with no database after any
# reboot, which is the state a shop opens to.
#
# MOUNTING IS NOT DONE HERE. `var-lib-kitluy-hub.mount` owns it, because a
# service that mounts inside its own sandbox namespace would mount into that
# namespace alone — the database and the agent would see an empty directory
# while this unit reported success.
if [ -e "/dev/mapper/$MAPPER_NAME" ]; then
  log "data volume already unlocked as $MAPPER_NAME"
  exit 0
fi

# -----------------------------------------------------------------------------
# 2. Find the NVMe
# -----------------------------------------------------------------------------
# Resolved by TYPE, never by a hardcoded /dev/nvme0n1: a Hub with two drives, or
# one that enumerates differently after a firmware update, must not silently
# encrypt the wrong disk.
find_nvme || die "no NVMe drive found. A Store Hub keeps the Store's database on NVMe and does not fall back to the boot card (owner decision). Fit an NVMe drive and reboot."

log "found NVMe at $NVME_DEVICE"

# The BOOT device must never be touched. On this architecture the Pi boots from
# the SD card and NVMe is data only; a Hub that ever booted from NVMe would have
# this script pointed at its own root filesystem.
ROOT_SOURCE="$(findmnt -no SOURCE / 2>/dev/null || echo '')"
case "$ROOT_SOURCE" in
  "$NVME_DEVICE"*) die "$NVME_DEVICE carries the running root filesystem; refusing to reformat the disk this Hub booted from" ;;
esac

# -----------------------------------------------------------------------------
# 3. Derive the hardware-bound passphrase
# -----------------------------------------------------------------------------
# The posture was resolved in section 0, before any device was touched, and the
# key material it implies was committed there too. Nothing is left to decide.
# -----------------------------------------------------------------------------
# 4. Format, if this drive is not already ours
# -----------------------------------------------------------------------------
install -d -m 0700 "$STATE_DIR"

if cryptsetup isLuks "$NVME_DEVICE" 2>/dev/null; then
  log "$NVME_DEVICE already carries a LUKS container"
else
  # A drive that is neither LUKS nor blank is somebody's data. Refusing is the
  # only safe answer: this script cannot tell a spare drive from one carrying
  # another Store's records, and formatting the wrong one is unrecoverable.
  if blkid "$NVME_DEVICE" >/dev/null 2>&1; then
    die "$NVME_DEVICE already holds a filesystem that is not a KitLuy volume; refusing to destroy data this Hub cannot identify. Wipe it deliberately if it is spare."
  fi
  log "formatting $NVME_DEVICE as LUKS2 (this destroys nothing — the drive is blank)"
  derive_passphrase | cryptsetup luksFormat \
    --type luks2 \
    --cipher aes-xts-plain64 \
    --key-size 512 \
    --hash sha256 \
    --pbkdf argon2id \
    --batch-mode \
    "$NVME_DEVICE" -
fi

# -----------------------------------------------------------------------------
# 5. Open and mount
# -----------------------------------------------------------------------------
if [ ! -e "/dev/mapper/$MAPPER_NAME" ]; then
  # `--key-file=-`, NOT a trailing `-`.
  #
  # `luksFormat` accepts a POSITIONAL key file, so `luksFormat <device> -` reads
  # stdin and is correct above. `open` does not: its positional arguments are
  # <device> and <name>, and a third `-` is not a key file. cryptsetup then asks
  # for a passphrase interactively instead of reading the one on stdin, and
  # under systemd — with no terminal — that surfaces as
  # "No key available with this passphrase" on a volume whose key is perfectly
  # good. The format above had already succeeded, so the drive was encrypted and
  # unopenable in the same run.
  #
  # This never fired before BRINGUP-003 because the OTP gate refused first: no
  # board ever reached this line.
  derive_passphrase | cryptsetup open --type luks2 --key-file=- "$NVME_DEVICE" "$MAPPER_NAME"
  log "unlocked $NVME_DEVICE as $MAPPER_NAME"
fi

if ! blkid "/dev/mapper/$MAPPER_NAME" >/dev/null 2>&1; then
  log "creating the data filesystem"
  mkfs.ext4 -q -L kitluy-hub "/dev/mapper/$MAPPER_NAME"
fi

# The mount point must exist for the .mount unit that follows.
install -d -m 0700 "$MOUNT_POINT"

log "encrypted volume unlocked as /dev/mapper/${MAPPER_NAME}; var-lib-kitluy-hub.mount will mount it at ${MOUNT_POINT}"
