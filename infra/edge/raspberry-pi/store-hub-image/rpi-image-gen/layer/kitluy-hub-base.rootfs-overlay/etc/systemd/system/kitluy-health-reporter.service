[Unit]
Description=KitLuy bootstrap health reporter
After=kitluy-firstboot.service network-online.target
Wants=network-online.target
Requires=kitluy-firstboot.service
ConditionPathExists=/usr/lib/kitluy/health-reporter

[Service]
Type=simple
ExecStart=/usr/lib/kitluy/health-reporter
User=root
Restart=always
RestartSec=60s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/kitluy/health
StateDirectory=kitluy
# 0751, NOT 0750/0700 — the LAST digit is load-bearing.
#
# PostgreSQL runs as the `postgres` user, and its cluster lives on the
# encrypted volume mounted at /var/lib/kitluy/hub. Reaching it means
# TRAVERSING /var/lib/kitluy, and `postgres` is neither the owner nor in the
# group — so without the final execute bit initdb fails with
# "could not access directory ... Permission denied" on a directory it owns.
# Every unit that declares this StateDirectory must agree, because systemd
# re-applies the mode on each start and the strictest one would win back.
#
# `x` without `r` grants TRAVERSAL ONLY: /var/lib/kitluy still cannot be
# listed by others, and identity/, operational/ and the rest stay 0700.
StateDirectoryMode=0751

[Install]
WantedBy=multi-user.target
