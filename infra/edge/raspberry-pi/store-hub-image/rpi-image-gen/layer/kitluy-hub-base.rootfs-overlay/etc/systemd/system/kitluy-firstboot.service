[Unit]
Description=KitLuy first-boot device identity
Documentation=00_AI_HANDOFF/edge-platform/27_SYSTEMD_RUNTIME_RECONCILIATION.md
# Identity must exist before anything can prove possession of it. Every
# consumer (cloud registration, the pairing console) orders itself After= this
# unit with Requires=, so no Before= is needed here. The flash-time ticket
# agent this once ordered before is RETIRED from the Store Hub image (plan
# §5.3): its identity included the SD card, so a re-flashed board minted a
# SECOND device and the duplicate-evidence tripwire contained both (2026-08-31).
After=local-fs.target
ConditionPathExists=/usr/lib/kitluy/firstboot-identity

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/kitluy/firstboot-identity
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
# The identity directory is the ONLY path this unit may write.
ReadWritePaths=/var/lib/kitluy/identity
StateDirectory=kitluy/identity
# 0751, NOT 0750/0700 — the LAST digit is load-bearing.
#
# PostgreSQL runs as the `postgres` user, and its cluster lives on the
# encrypted volume mounted at /var/lib/kitluy/hub. Reaching it means
# TRAVERSING /var/lib/kitluy, and `postgres` is neither the owner nor in the
# group — so without the final execute bit initdb fails with
# "could not access directory ... Permission denied" on a directory it owns.
# Every unit that declares this StateDirectory must agree, because systemd
# re-applies the mode on each start and the strictest one would win back.
#
# `x` without `r` grants TRAVERSAL ONLY: /var/lib/kitluy still cannot be
# listed by others, and identity/, operational/ and the rest stay 0700.
StateDirectoryMode=0751

[Install]
WantedBy=multi-user.target
