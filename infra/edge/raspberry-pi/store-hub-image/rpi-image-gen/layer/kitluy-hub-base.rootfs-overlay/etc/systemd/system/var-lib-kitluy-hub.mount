[Unit]
Description=KitLuy Store Hub encrypted data volume
Documentation=infra/edge/raspberry-pi/store-hub-image/README.md
# systemd performs this mount in the HOST namespace. Doing it inside a sandboxed
# service instead would mount into that service's own private namespace, so the
# database and the agent would see an empty directory while the unit reported
# success — the failure mode that makes this worth a separate unit.
#
# NOT PART OF local-fs.target (hardware 2026-09-16, handoff 46 §5). With default
# dependencies a mount unit is ordered Before=local-fs.target, but this one must
# wait for kitluy-hub-storage.service, an ordinary service that itself runs after
# sysinit.target — and sysinit.target waits for local-fs.target. systemd broke
# that cycle at EVERY boot by deleting the start jobs of systemd-timesyncd (the
# Hub never synchronised its clock and sat a day behind), systemd-tmpfiles-setup
# and local-fs.target itself. This is a late, application-level volume, so it
# opts out of the defaults and restores the one that still matters: unmount at
# shutdown. The mount still follows /var (RequiresMountsFor from Where=) and the
# storage unit, and the database still follows it.
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target
Requires=kitluy-hub-storage.service
After=kitluy-hub-storage.service
ConditionPathExists=/dev/mapper/kitluy-hub-data

[Mount]
What=/dev/mapper/kitluy-hub-data
Where=/var/lib/kitluy/hub
Type=ext4
# noexec: this volume holds a database and nothing that should ever be executed
# from it. PostgreSQL runs from /usr, never from its data directory.
Options=noatime,nodev,nosuid,noexec

[Install]
WantedBy=multi-user.target
