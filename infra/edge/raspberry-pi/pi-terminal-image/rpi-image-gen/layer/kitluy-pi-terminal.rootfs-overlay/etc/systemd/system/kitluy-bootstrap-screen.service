# The unassigned-terminal status screen, on the console.
#
# WHY NOT UNDER WAYLAND
# ---------------------
# This ran as `labwc -s terminal-bootstrap-ui` and showed nothing on the first
# real device (2026-08-13). Two reasons, both structural rather than a bug to
# patch:
#
#   1. labwc died starting Xwayland — `/tmp/.X11-unix` does not exist and the
#      unit set PrivateTmp=yes, so it could not be provided from the image.
#   2. Even with the compositor up, the screen would have stayed blank. The
#      status program writes ANSI text on stdout: it clears the screen and
#      redraws every 5 seconds. Inside a compositor that output reaches the
#      journal, not the display, and the image ships no terminal emulator to
#      draw it in.
#
# The program was always a console TUI. It is run as one here — no compositor,
# no Xwayland, no GPU, no seat. That removes every failure mode above and works
# on any Pi with a display attached.
#
# The Wayland session unit is kept in the image for the POS application, which
# genuinely needs a compositor. It is no longer started at boot, because it has
# nothing to show until that application exists.
[Unit]
Description=KitLuy unassigned-terminal status screen (console)
# THE TTY1 OWNER OF THIS SLICE. It shows Factory Enrollment truth — device id,
# "Waiting for approval" or "Approved", and Store always Unassigned — and takes
# no input. runtime-manifest.json names kitluy-terminal-session.service as its
# declared SUCCESSOR: the graphical Device Shell slice gives that unit the wants
# symlink and a Conflicts= on this one, removes this unit's symlink, and swaps
# the two `enabled` flags. Until then this screen is the product on tty1.
#
# Ordered after cloud registration so the first paint already reflects the
# registration agent's first pass rather than an empty state file; ordering
# only, never Requires= — the screen must still come up when the network is
# down, and say so.
After=kitluy-firstboot.service kitluy-cloud-registration.service
# The status screen OWNS tty1. Without this, getty prints a login prompt over
# it and an operator sees a login they can never satisfy — root is locked and
# `pi` is password-disabled by design.
Conflicts=getty@tty1.service
ConditionPathExists=/usr/lib/kitluy/terminal-bootstrap-ui

[Service]
Type=simple
# root, deliberately: this only reads a state file and writes to a tty, and
# running it unprivileged would need a seat and device rules for no benefit.
User=root
EnvironmentFile=/etc/kitluy/image.env
ExecStart=/usr/lib/kitluy/terminal-bootstrap-ui
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=5s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
# Reads the bootstrap state the agents write. It needs no write access at all:
# a status surface that could alter what it reports would not be a status
# surface.
ReadOnlyPaths=/var/lib/kitluy

[Install]
WantedBy=multi-user.target
