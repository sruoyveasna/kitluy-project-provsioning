# The Pi Terminal's graphical first-boot surface, on the display.
#
# WHAT REPLACED WHAT, AND WHY
# ---------------------------
# `kitluy-bootstrap-screen.service` printed ANSI text on tty1: device id,
# "Waiting for approval" / "Approved", and Store always Unassigned. It was
# honest and it worked, but it takes NO INPUT — and the terminal provisioning
# model requires a human to type an eight-character pairing code at the Pi.
# There was no screen on any KitLuy image capable of accepting one.
#
# This unit is that screen. `runtime-manifest.json` recorded the swap in advance
# (`tty1.owner` -> `tty1.successor`), and this is the slice that performs it: the
# text screen loses its wants symlink, this one gains it, and the two `enabled`
# flags trade places.
#
# WHY cage AND NOT labwc
# ----------------------
# labwc is a general compositor: it has a desktop, and therefore a way out of
# the application. cage shows exactly one program, full screen, with nothing
# behind it. On a shop counter that difference is the whole point.
#
# The retired `kitluy-terminal-session.service` ran `labwc -s terminal-bootstrap-ui`
# — a compositor wrapped around a TEXT program, which is why the first real
# terminal (2026-08-13) showed a blank display: ANSI on stdout inside a
# compositor reaches the journal, not the screen. That unit stays in the image,
# still not enabled, for the governed POS release that genuinely needs labwc.
[Unit]
Description=KitLuy Pi Terminal Device Shell (kiosk, cage + Electron)
Documentation=00_AI_HANDOFF/apps/2026-09-04__APPS__KL-P1-TERM-SHELL-001__PI-TERMINAL-DEVICE-SHELL-APP__AI-HANDOFF.md
# Ordered after registration so the first paint already reflects the agent's
# first pass rather than an empty state file. Ordering only, never Requires=:
# the screen must come up when the network is down and SAY so — "no network" is
# one of the states it is built to render.
After=kitluy-firstboot.service kitluy-cloud-registration.service seatd.service systemd-user-sessions.service
Wants=seatd.service
# THE DISPLAY HAS ONE OWNER. Without these, the text screen and this one both
# draw, and getty prints a login prompt over whichever wins — a login no one can
# satisfy, because root is locked and `pi` is password-disabled by design.
# NO After=kitluy-terminal-client.service HERE, deliberately.
#
# The POS unit carries After=kitluy-device-shell.service, and that ONE edge
# already orders BOTH hand-overs. systemd.unit(5): "given two units with any
# ordering dependency between them, if one unit is shut down and the other is
# started up, the shutdown is ordered before the start-up" — so the shell's
# stop precedes the POS's start, and on a hand-back (a failed release,
# OnFailure=) the POS's stop precedes the shell's start. The seat is free in
# both directions from the single edge.
#
# Adding the mirror edge here made the two units order after EACH OTHER, and
# with terminal-client -> terminal-edge -> operational-tls -> device-shell it
# closed a four-unit loop. systemd broke the loop the only way it can: "Job
# kitluy-device-shell.service/start deleted to break ordering cycle" — the
# kiosk was silently dropped from the boot transaction and never ran, with not
# one line in its own journal to say so. Hardware, 2026-09-21: a freshly
# flashed board sat on a black screen through registration and approval.
Conflicts=kitluy-bootstrap-screen.service
Conflicts=getty@tty1.service
# The same guard every unit in this tree carries: an image built before the
# runtime was packaged sits quietly inactive instead of restart-looping against
# an absent binary.
ConditionPathExists=/usr/lib/kitluy/device-shell
ConditionPathExists=/usr/lib/kitluy/electron/electron

[Service]
Type=simple
# A REAL system user, never root: this process renders a browser engine. The
# retired session unit used `User=%i` in a non-template unit, where the specifier
# expands to the empty string and User= is silently unset — the compositor then
# ran as root with a GPU attached.
User=kitluy-terminal
Group=kitluy-terminal
EnvironmentFile=/etc/kitluy/image.env
EnvironmentFile=/etc/kitluy/terminal.env

# XDG_RUNTIME_DIR FROM systemd, NOT FROM /run/user.
#
# Wayland needs a writable, 0700, user-owned runtime directory. The obvious
# choice is /run/user/%U — but that is exactly what `ProtectHome=yes` makes
# inaccessible, and this unit keeps ProtectHome. `RuntimeDirectory=` gives the
# same guarantees under a path the sandbox does not hide, and it is cleaned up
# on stop, so a crashed session leaves no stale socket for the next one to trip
# over. It also removes the need for `PAMName=login` and a full logind session.
RuntimeDirectory=kitluy-device-shell
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/kitluy-device-shell
Environment=XDG_SESSION_TYPE=wayland
# Chromium writes a cache and a config under HOME. The kiosk user's home is
# /var/lib/kitluy/terminal (sysusers.d/60-kitluy-terminal.conf), which is on the
# data partition and writable — so the shell has somewhere to put them without
# widening anything.
Environment=HOME=/var/lib/kitluy/terminal

# XWAYLAND'S SOCKET DIRECTORY IS NOT THIS UNIT'S JOB.
#
# cage starts Xwayland unconditionally and exits when it cannot, and Xwayland
# needs /tmp/.X11-unix. The image already ships the correct answer —
# `/usr/lib/tmpfiles.d/x11.conf` declares that directory — it simply had no
# writable /tmp to create it in, because the erofs root is read-only and no
# `tmp.mount` existed. That is fixed in the base overlay, so systemd-tmpfiles
# does this at boot and nothing is needed here.
#
# An earlier attempt put `ExecStartPre=install -d /tmp/.X11-unix` here and it
# could not work: `PrivateTmp=yes` builds a unit's private tmp inside the REAL
# /tmp, so on a read-only /tmp the sandbox never forms and even /tmp is absent.
# The error was "cannot create directory '/tmp': Permission denied", which reads
# like a permissions problem and is really a missing filesystem.

# THE KIOSK USER MUST OWN ITS OWN HOME.
#
# The image creates /var/lib/kitluy/terminal as root (the layer's `install -d`),
# but the shell runs as `kitluy-terminal` and Chromium writes a shader cache and
# its config under HOME. Without this it logs
#   Failed to create /var/lib/kitluy/terminal/.cache ... (Permission denied)
# on every start — not fatal, but it means no shader cache and a slower paint on
# a device whose whole job is to draw one screen.
#
# `+` runs this as root regardless of User=, and it is idempotent. Done here
# rather than at build time because the uid is allocated by systemd-sysusers and
# a unit that fixes its own directory keeps working on an image built before the
# ownership was ever considered.
ExecStartPre=+/usr/bin/chown kitluy-terminal:kitluy-terminal /var/lib/kitluy/terminal

ExecStart=/usr/lib/kitluy/device-shell
# The screen is the product on this device: if it dies, it comes back.
Restart=always
RestartSec=5s
# But a screen that cannot start must end up `failed` and visible in
# `systemctl --failed`, not cycle through `activating` for ever hiding the one
# journal line that says why. This is the D-27 lesson applied to the display.
StartLimitIntervalSec=300
StartLimitBurst=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# RestrictRealtime is deliberately NOT set: a compositor legitimately asks for
# realtime scheduling to pace frames, and refusing it degrades the display
# rather than hardening it. Recorded as an intentional exception, the same one
# kitluy-terminal-session.service records.
#
# RestrictNamespaces is deliberately NOT set either, and this one is load-bearing:
# Chromium's renderer sandbox is built on unprivileged USER NAMESPACES. Setting
# it would leave the shell running with its own sandbox disabled, which is a
# worse trade than the namespace it needs to make it work.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
# The seat: DRM for the display, input for the touchscreen. Nothing else.
DeviceAllow=char-drm rw
DeviceAllow=char-input rw
SupplementaryGroups=video input render
# WRITES ONLY ITS OWN DIRECTORY. The agents' state files under /var/lib/kitluy
# stay root-owned and are READ from here; the seat this shell records after
# pairing goes in the kiosk user's own directory, and nowhere else.
ReadWritePaths=/var/lib/kitluy/terminal

[Install]
WantedBy=multi-user.target
