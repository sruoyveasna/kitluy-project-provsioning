# The Store Hub itself: the LAN /edge/v1 API on 7443, local authority, sync.
#
# WHY THIS UNIT DID NOT EXIST UNTIL NOW
# -----------------------------------------------------------------------------
# A unit by this name lived in `scripts/profiles/store-hub.sh` — the LEGACY build
# path, which refuses to emit an .img (exit 3). The real builder drives
# rpi-image-gen layers and never sourced that profile, so every flashable card
# shipped without a Hub agent while `kitluy-store-hub.yaml` still published an
# avahi `_kitluy-edge._tcp` advert on 7443. The Pi advertised a service that
# could not exist. `runtime-manifest.json` and `test/image-contents.test.sh` now
# make that specific divergence fail the build instead of the shop.
#
# WHY NOT `Requires=postgresql.service`
# -----------------------------------------------------------------------------
# The legacy unit did exactly that, and it could never have worked here:
# `postgresql.service` is MASKED to /dev/null in this overlay (see
# etc/kitluy/README-postgresql-masked.txt), and a Requires= on a masked unit
# fails the job outright. The Hub's database is `kitluy-hub-database.service`,
# which owns a cluster on the encrypted volume and is the real dependency.
[Unit]
Description=KitLuy Store Hub agent (LAN /edge/v1 API, local authority, sync)
Documentation=infra/kitluy-store-hub-image/README.md
# The database unit is oneshot+RemainAfterExit, so Requires= holds for the life
# of the boot once it has succeeded. It in turn Requires= the encrypted mount,
# so this single line pulls the whole storage chain.
Requires=kitluy-hub-database.service
After=kitluy-hub-database.service network-online.target
Wants=network-online.target
# The same guard every unit in this tree carries. Without it, an image built
# before the agent was packaged would restart-loop against an absent binary
# instead of sitting quietly inactive — the shape of defect D-27.
ConditionPathExists=/usr/lib/kitluy/hub-agent

[Service]
Type=simple
ExecStart=/usr/lib/kitluy/hub-agent
User=root
EnvironmentFile=/etc/kitluy/image.env
EnvironmentFile=/etc/kitluy/hub.env

# ON-FAILURE, NOT ALWAYS — this is the D-27 lesson applied.
#
# The agent exits 0 when it decides not to serve: no database yet, schema
# pending, no certificate material, an ambiguous interface. Those are CONFIGURED
# outcomes waiting on an operator or an owner decision, and `Restart=always`
# would cycle the unit through `activating` for ever, hiding the one journal line
# that says which. A genuine crash still exits non-zero and is retried.
Restart=on-failure
RestartSec=10s
# A crash that repeats must end up `failed` and visible in `systemctl --failed`,
# not cycling silently. D-27 hid for a week precisely because it never latched.
StartLimitIntervalSec=300
StartLimitBurst=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
# Binds 7443 on the Store LAN, so it needs the network namespace — unlike the
# storage and database units, which are deliberately PrivateNetwork=yes.
# AF_NETLINK is not optional. libuv enumerates local interfaces with a netlink
# socket, so without it Node fails at startup with
#   uv_interface_addresses returned Unknown system error 97 (EAFNOSUPPORT)
# and the agent never reaches its own bind-host resolution (hardware,
# 2026-09-10). It grants no route off the device: netlink talks to the local
# kernel only.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
# The agent reads its identity and credential from /var/lib/kitluy, and the
# database socket from /run/postgresql. Both scoped explicitly.
ReadWritePaths=/var/lib/kitluy /run/postgresql
StateDirectory=kitluy
# 0751, NOT 0750/0700 — the LAST digit is load-bearing.
#
# PostgreSQL runs as the `postgres` user, and its cluster lives on the
# encrypted volume mounted at /var/lib/kitluy/hub. Reaching it means
# TRAVERSING /var/lib/kitluy, and `postgres` is neither the owner nor in the
# group — so without the final execute bit initdb fails with
# "could not access directory ... Permission denied" on a directory it owns.
# Every unit that declares this StateDirectory must agree, because systemd
# re-applies the mode on each start and the strictest one would win back.
#
# `x` without `r` grants TRAVERSAL ONLY: /var/lib/kitluy still cannot be
# listed by others, and identity/, operational/ and the rest stay 0700.
StateDirectoryMode=0751

[Install]
WantedBy=multi-user.target
