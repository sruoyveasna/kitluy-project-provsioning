[Unit]
Description=KitLuy Store Hub encrypted data volume
Documentation=infra/kitluy-store-hub-image/README.md
# systemd performs this mount in the HOST namespace. Doing it inside a sandboxed
# service instead would mount into that service's own private namespace, so the
# database and the agent would see an empty directory while the unit reported
# success — the failure mode that makes this worth a separate unit.
Requires=kitluy-hub-storage.service
After=kitluy-hub-storage.service
ConditionPathExists=/dev/mapper/kitluy-hub-data

[Mount]
What=/dev/mapper/kitluy-hub-data
Where=/var/lib/kitluy/hub
Type=ext4
# noexec: this volume holds a database and nothing that should ever be executed
# from it. PostgreSQL runs from /usr, never from its data directory.
Options=noatime,nodev,nosuid,noexec

[Install]
WantedBy=multi-user.target
