[Unit]
Description=KitLuy fleet enrollment bootstrap client
After=kitluy-firstboot.service network-online.target
Wants=network-online.target
Requires=kitluy-firstboot.service
ConditionPathExists=/usr/lib/kitluy/enrollment-agent

[Service]
Type=simple
ExecStart=/usr/lib/kitluy/enrollment-agent
User=root
Restart=always
RestartSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/kitluy/enrollment
StateDirectory=kitluy
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
