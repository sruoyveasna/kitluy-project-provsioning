#!/bin/sh
# KitLuy fleet enrollment bootstrap client.
#
# HONEST STATE REPORTING (§11). The cloud factory-enrollment endpoint does not
# exist yet. This agent therefore reports a controlled, retryable bootstrap
# state and exits 0 — it never claims enrollment succeeded, and it never
# crash-loops, because a restart loop on an unbuilt backend is indistinguishable
# from a real fault at 03:00.
set -eu
exec /usr/bin/node /usr/lib/kitluy/lib/firstboot-agent/bin/enrollment-bootstrap.js "$@"
