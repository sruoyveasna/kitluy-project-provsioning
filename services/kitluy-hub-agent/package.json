{
  "name": "@kitluy-services/kitluy-hub-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Store Hub agent — HET-managed local edge appliance and operational authority for one Store Location (Store Hub spec v1.0.0). Linux ARM64 target, local PostgreSQL, LAN API, transactional outbox, async cloud sync.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:offline": "vitest run test/offline-reconnect.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kitluy/api-errors": "workspace:*",
    "@kitluy/approvals": "workspace:*",
    "@kitluy/audit": "workspace:*",
    "@kitluy/edge-contracts": "workspace:*",
    "@kitluy/event-contracts": "workspace:*",
    "@kitluy/money": "workspace:*",
    "@kitluy/observability": "workspace:*",
    "@kitluy/payments": "workspace:*",
    "@kitluy/rbac": "workspace:*",
    "@kitluy/resource-scope": "workspace:*",
    "@kitluy/shared-config": "workspace:*",
    "@kitluy/shared-types": "workspace:*",
    "@kitluy/sync-protocol": "workspace:*",
    "@kitluy-verticals/phase1-laundry": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "vitest": "catalog:"
  }
}
