# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
# The Hub agent's single-file bundle. A build intermediate like dist/:
# `pnpm --filter @kitluy-services/kitluy-hub-agent build:bundle` regenerates it,
# and the copy the image actually ships is the tracked one under
# infra/edge/raspberry-pi/store-hub-image/.../usr/lib/kitluy/lib/hub-agent/main.mjs.
dist-bundle/
build/
.next/
out/
.turbo/
coverage/

# Environment and secrets — never commit real values
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Supabase local state
supabase/.branches/
supabase/.temp/

# Terraform state — never commit state or variable values
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.example.tfvars

# OS / editor
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# Test artifacts
playwright-report/
test-results/
dist-electron/
# The POS release payload: a build intermediate like dist/, packed and signed by
# `pnpm release:publish --product kitluy-terminal` (T1-STORE-OPERATIONS-001).
apps/kitluy-pos-desktop-app/release-payload/

# ...EXCEPT the Device Shell as the IMAGE ships it.
#
# `<layer>.rootfs-overlay/` is not build scratch — it is the tree rpi-image-gen
# bakes onto the card, and this repository commits packaged output there: the
# firstboot agent's JS closure has been tracked that way since it existed, and
# `scripts/verification/secret-scan.mjs` records the convention in as many words.
# The Device Shell's compiled app is the same kind of artifact and belongs under
# the same rule, or a clean clone builds an image whose screen is simply missing
# — silently, because the unit's ConditionPathExists makes an absent shell look
# like a quiet boot rather than a broken one.
#
# The directory is re-included before its contents: git cannot re-include a file
# whose parent directory is still excluded.
!infra/edge/raspberry-pi/pi-terminal-image/rpi-image-gen/layer/*.rootfs-overlay/usr/lib/kitluy/lib/device-shell/dist/
!infra/edge/raspberry-pi/pi-terminal-image/rpi-image-gen/layer/*.rootfs-overlay/usr/lib/kitluy/lib/device-shell/dist/**
!infra/edge/raspberry-pi/pi-terminal-image/rpi-image-gen/layer/*.rootfs-overlay/usr/lib/kitluy/lib/device-shell/dist-electron/
!infra/edge/raspberry-pi/pi-terminal-image/rpi-image-gen/layer/*.rootfs-overlay/usr/lib/kitluy/lib/device-shell/dist-electron/**

# Store Hub local development backups (WS-09) — binary pg_dump artifacts.
# Backup/restore is exercised by `pnpm hub:db:backup` / `hub:db:restore`;
# the dumps themselves are disposable local evidence, never committed.
hub/.backups/
