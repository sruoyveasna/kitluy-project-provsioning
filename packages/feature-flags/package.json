{
  "name": "@kitluy/feature-flags",
  "version": "0.1.0",
  "private": true,
  "description": "Feature flags and vertical phase gates (Phase 1 active; Phases 2-8 registered, inactive)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@kitluy/shared-types": "workspace:*"
  }
}
