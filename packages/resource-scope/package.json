{
  "name": "@kitluy/resource-scope",
  "version": "0.1.0",
  "private": true,
  "description": "Resource scope model: platform, region, tenant, chain, digital store, store location, device group, device, connector, service, release cohort, support session, file object",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@kitluy/shared-types": "workspace:*"
  }
}
