{
  "name": "het-kitluy-project",
  "version": "0.1.0",
  "private": true,
  "description": "KitLuy Suite monorepo \u2014 digital-first commerce platform for Cambodia. Phase 1: Laundry Stores and Shops.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "clock:check": "node scripts/verification/clock-usage-check.mjs",
    "contracts:validate": "node scripts/contracts/validate-openapi.mjs",
    "db:apply": "node scripts/database/db-exec.mjs apply",
    "db:deploy:hosted-dev": "node scripts/database/db-deploy-hosted-dev.mjs",
    "db:deploy:hosted-dev:check": "node scripts/database/hosted-dev-target.test.mjs",
    "db:migrations:check": "node scripts/database/validate-migrations.mjs",
    "db:reset": "node scripts/database/db-exec.mjs reset",
    "db:schema:check": "node scripts/database/db-schema-check.mjs",
    "db:seed": "node scripts/database/db-exec.mjs seed",
    "db:test": "node scripts/database/db-exec.mjs test",
    "db:types": "node scripts/database/db-exec.mjs types",
    "db:validate": "node scripts/database/db-validate.mjs",
    "dev": "turbo run dev",
    "dev:fleet": "node scripts/development/fleet-service.mjs",
    "dev:fleet:watch": "node scripts/development/fleet-watch.mjs",
    "dev:seed:hosted-scope": "node scripts/development/seed-hosted-dev-scope.mjs",
    "device:prepare": "pnpm --filter @kitluy-services/kitluy-device-firstboot-agent build && pnpm --filter @kitluy-services/kitluy-device-firstboot-agent prepare-card",
    "docs:authority-check": "node scripts/docs/check-authority.mjs",
    "docs:check": "node scripts/verification/docs-link-check.mjs",
    "docs:classify": "node scripts/docs/classify.mjs",
    "docs:classify:check": "node scripts/docs/check-classified.mjs",
    "docs:coverage-check": "node scripts/docs/check-coverage.mjs",
    "docs:duplicates": "node scripts/docs/check-duplicates.mjs",
    "docs:hash": "node scripts/docs/check-hashes.mjs",
    "docs:inbox-state": "node scripts/docs/check-inbox-state.mjs",
    "docs:inventory": "node scripts/docs/inventory.mjs",
    "docs:links": "node scripts/verification/docs-link-check.mjs",
    "docs:registry-check": "node scripts/docs/check-registry.mjs",
    "docs:verify": "node scripts/docs/verify.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hub:db:apply": "node scripts/hub/hub-db.mjs apply",
    "hub:db:backup": "node scripts/hub/hub-db.mjs backup",
    "hub:db:reset": "node scripts/hub/hub-db.mjs reset",
    "hub:db:restore": "node scripts/hub/hub-db.mjs restore",
    "hub:db:seed": "node scripts/hub/hub-db.mjs seed",
    "hub:db:status": "node scripts/hub/hub-db.mjs status",
    "hub:db:test": "node scripts/hub/hub-db.mjs test",
    "hub:db:validate": "node scripts/hub/hub-validate.mjs",
    "lint": "eslint .",
    "migrations:validate": "node scripts/database/validate-migrations.mjs",
    "secret:scan": "node scripts/verification/secret-scan.mjs",
    "supabase:reset:local": "bash scripts/database/supabase-local.sh reset",
    "supabase:start": "bash scripts/database/supabase-local.sh start",
    "supabase:status": "node scripts/database/db-exec.mjs status",
    "supabase:stop": "bash scripts/database/supabase-local.sh stop",
    "test": "turbo run test --concurrency=1",
    "test:contract": "turbo run test:contract",
    "test:e2e": "node scripts/testing/blocked.mjs e2e",
    "test:hardware": "node scripts/testing/blocked.mjs hardware",
    "test:integration": "node scripts/testing/blocked.mjs integration",
    "test:load": "node scripts/testing/blocked.mjs load",
    "test:offline": "turbo run test:offline",
    "test:recovery": "node scripts/testing/blocked.mjs recovery",
    "test:rls": "node scripts/database/db-exec.mjs rls",
    "test:security": "node scripts/testing/blocked.mjs security",
    "typecheck": "turbo run typecheck",
    "verify": "node scripts/verification/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "pg": "catalog:",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0",
    "yaml": "^2.6.1"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "electron"
    ]
  }
}
