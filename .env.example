# ============================================================================
# KitLuy Suite — environment variable reference (names and descriptions ONLY).
# Never put real values in this file. Copy to .env locally; .env is gitignored.
# Production values live in the approved provider secret manager, never in git.
# ============================================================================

# --- Runtime environment ---
# One of: local | development | staging | pilot | production | disaster_recovery
KITLUY_ENV=local

# --- Supabase (cloud metadata, auth, RLS, event records) ---
# Local development values come from `supabase start`. Production project ref is
# [REQUIRED: production Supabase project reference — owner decision pending].
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: server-side only. NEVER in apps, POS terminals, or Store Hub.
SUPABASE_SERVICE_ROLE_KEY=

# --- DigitalOcean (application hosting, Spaces, registry) ---
# [REQUIRED: DO project name, region, Spaces bucket names — owner decisions pending]
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=

# --- Service identity ---
# Each cloud service resolves its own name/version for observability.
KITLUY_SERVICE_NAME=
KITLUY_SERVICE_VERSION=

# --- Store Hub (edge, local development simulation only) ---
# Local PostgreSQL connection for the simulated Store Hub. Never a cloud DSN.
HUB_LOCAL_DATABASE_URL=
HUB_LAN_BIND_HOST=127.0.0.1
HUB_LAN_PORT=

# --- Management API (governed Admin control plane) ---
# Server-side only. The API holds the TRUSTED database identity: authority to
# CONNECT, never authority to ACT — every authorization answer still comes from
# kitluy_auth.has_permission() evaluated for the calling user.
# Session-mode pooler DSN (IPv4). Never a browser value.
MANAGEMENT_API_DATABASE_URL=
# Auth base URL, origin only, no path.
MANAGEMENT_API_AUTH_URL=
# PUBLISHABLE key only. A service-role credential here is refused at startup.
MANAGEMENT_API_AUTH_PUBLISHABLE_KEY=
# Comma-separated exact origin allowlist for the Admin Portal. Never "*".
MANAGEMENT_API_ALLOWED_ORIGINS=

# --- Admin PWA Portal (browser bundle) ---
# Only public values may appear here: Vite inlines every VITE_ variable into the
# shipped JavaScript. A privileged credential in the publishable slot is refused
# by @kitluy/supabase-client at construction.
VITE_KITLUY_SUPABASE_URL=
VITE_KITLUY_SUPABASE_PUBLISHABLE_KEY=
VITE_KITLUY_MANAGEMENT_API_URL=

# --- Localization defaults (owner-locked: Cambodia-first) ---
KITLUY_DEFAULT_TIMEZONE=Asia/Phnom_Penh
KITLUY_DEFAULT_LOCALES=km-KH,en-US
KITLUY_DEFAULT_CURRENCIES=KHR,USD
